# PayUno Flow — environment (all optional in development)
PORT=3000
DATA_DIR=./storage                 # SQLite file + private object storage + per-tenant RT-FEPE state
DATABASE_FILE=./storage/payuno.db
SEED_DEMO=1                        # set 0 in production: no demo organisations
PUBLIC_URL=https://flow.example.com  # used inside invoice QR links
COOKIE_SECURE=1                    # behind HTTPS
TRUST_PROXY=1                      # when behind a reverse proxy
# Secrets: generated and stored in the database if absent. Set them from a secret manager in production.
QR_SIGNING_SECRET=
PROVIDER_WEBHOOK_SECRET=
FIELD_ENCRYPTION_KEY=              # base64, 32 bytes: AES-256-GCM for bank/tax fields
# Optional LLM interpreter for the AI Billing Agent (falls back to the rule engine; totals are always server-computed)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_PROVIDER=                       # "rules" forces the offline engine
